<%- include('partials/header.ejs') %>
  <!-- Main Content Container -->
  <main class="container">
    <h1 class="page-title">All Contacts</h1>

    <div class="action-bar">
      <a href="/add-contact" class="add-btn">
        <i class="fa-solid fa-circle-plus"></i> Add New
      </a>
    </div>

    <table class="contacts-table">
      <thead>
        <tr>
          <th>#</th>
          <th>First Name</th>
          <th>Last Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <!-- Dynamic EJS loop or fallback static rows -->
        <% if (typeof contacts !== 'undefined' && contacts.length > 0) { %>
          <% contacts.forEach((contact, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= contact.firstName %></td>
              <td><%= contact.lastName %></td>
              <td><%= contact.email %></td>
              <td><%= contact.phoneNumber ?? contact.phone %></td>
              <td class="action-icons">
                <a href="/show-contact/<%= contact._id %>" title="View"><i class="fa-solid fa-eye"></i></a>
                <a href="/update-contact/<%= contact._id %>" title="Edit"><i class="fa-regular fa-pen-to-square"></i></a>
                <a href="/delete-contact/<%= contact._id %>" class="delete-icon" title="Delete"><i class="fa-solid fa-xmark"></i></a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <!-- Default layout rendering matching your design -->
         
          
        <% } %>
      </tbody>
    </table>
  </main>

  <%- include('partials/footer.ejs') %>