<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add New Contact - Contact App</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <!-- Top Navbar -->
  <header class="navbar">
    <a href="/" class="brand-link">CONTACT APP</a>
  </header>

  <!-- Main Form Card Container -->
  <main class="form-container">
    <div class="form-card">
      
      <!-- Card Header -->
      <div class="card-header">
        <h2>Add New Contact</h2>
      </div>

      <!-- Add Form -->
      <form action="/add-contact" method="POST" class="contact-form">
        <div class="card-body">
          
          <div class="form-group">
            <label for="firstName">First Name</label>
            <input type="text" id="firstName" name="firstName" placeholder="Enter first name" required>
          </div>

          <div class="form-group">
            <label for="lastName">Last Name</label>
            <input type="text" id="lastName" name="lastName" placeholder="Enter last name" required>
          </div>

          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="Enter email address" required>
          </div>

          <div class="form-group">
            <label for="phone">Phone</label>
            <input type="text" id="phone" name="phone" placeholder="Enter phone number" required>
          </div>

          <div class="form-group align-top">
            <label for="address">Address</label>
            <textarea id="address" name="address" rows="3" placeholder="Enter full address"></textarea>
          </div>

        </div>

        <!-- Form Action Buttons -->
        <div class="card-footer">
          <button type="submit" class="btn btn-save">
            <i class="fa-solid fa-floppy-disk"></i> Save
          </button>
          <a href="/" class="btn btn-cancel">Cancel</a>
        </div>
      </form>

    </div>
  </main>

</body>
</html>